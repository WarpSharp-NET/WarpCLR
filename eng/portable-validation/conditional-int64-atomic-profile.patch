+// WarpCLR normative OpenCL extension profile: warpclr.opencl-int64-atomic-extensions/0.1.
+// OpenCL SPIR-V Environment section 5.2.8 permits Int64Atomics when the
+// consuming environment supports the base/extended atomic extensions.
+// The runtime independently authenticates both device extension tokens.
+// This validator profile requires both exact module declarations and does
+// not grant any other capability or skip any subsequent validation pass.
+bool IsEnabledByDeclaredInt64AtomicExtensionsOpenCL_2_2(
+    ValidationState_t& _, uint32_t capability) {
+  if (spv::Capability(capability) != spv::Capability::Int64Atomics) return false;
+  bool base = false;
+  bool extended = false;
+  for (const auto& instruction : _.ordered_instructions()) {
+    if (instruction.opcode() != spv::Op::OpExtension) continue;
+    const auto name = instruction.GetOperandAs<std::string>(0);
+    base |= name == "cl_khr_int64_base_atomics";
+    extended |= name == "cl_khr_int64_extended_atomics";
+  }
+  return base && extended;
+}
